# Цей файл — зразок налаштувань. Команда встановлення (`composer run setup`) копіює його в .env
# і сама заповнює ключ застосунку та доступ до бази. Після ручних змін у .env виконайте `php artisan config:clear`.

# ---------- Застосунок ----------
# Назва в листах і службових місцях; у заголовках вкладок — коротка «Seatly» з config/seatly.php
APP_NAME="Seatly Restaurant"
# local — розробка (докладні помилки, сторінка /ui-kit); production — робочий сервер
APP_ENV=local
# Ключ шифрування сесій і cookie; генерується командою `php artisan key:generate`. Нікому не показуйте
APP_KEY=
# true — на сторінці помилки видно код і запити. На робочому сервері обов'язково false
APP_DEBUG=true
# Адреса, за якою сайт відкривається у браузері. З `composer run dev` це http://localhost:8000;
# якщо сайт працює на власному домені (OSPanel, Laragon, Herd) — вкажіть його: від адреси залежать
# посилання в листах і QR-коди столиків
APP_URL=http://localhost:8000

# Основна мова сайту й адмінки
APP_LOCALE=uk
# Мова написів інтерфейсу, якщо в основній бракує перекладу (у Filament перекладено не все).
# На вміст із бази (меню, тексти сторінок) не впливає: там порожній переклад завжди замінюється українським
APP_FALLBACK_LOCALE=en
# Мова вигаданих імен у тестових даних
APP_FAKER_LOCALE=uk_UA

# Де зберігається позначка «сайт на обслуговуванні» (`php artisan down`); змінювати не потрібно
APP_MAINTENANCE_DRIVER=file

# Складність хешування паролів; більше — надійніше й повільніше. 12 — типове значення
BCRYPT_ROUNDS=12

# ---------- Журнал ----------
# Помилки пишуться в storage/logs/laravel.log. debug — усе підряд; на робочому сервері досить error
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- База даних ----------
# Параметри запитує й записує команда встановлення (`composer run setup`); вручну — див. README, розділ «База даних».
DB_CONNECTION=mysql
# Адреса сервера MySQL. В OSPanel 6 це назва модуля MySQL (наприклад, MySQL-8.4), а не localhost
DB_HOST=127.0.0.1
# Порт MySQL; типовий — 3306
DB_PORT=3306
# Назва бази. Порожню базу створює команда встановлення або ви самі; таблиці Laravel створить сам
DB_DATABASE=seatly
# Користувач MySQL. У OSPanel, Laragon і XAMPP типово root із порожнім паролем
DB_USERNAME=root
DB_PASSWORD=

# ---------- Сесії, кеш, черги ----------
# Усе зберігається в базі, тож окремі сервіси (Redis тощо) не потрібні
SESSION_DRIVER=database
# Через скільки хвилин бездіяльності працівника «викидає» з адмінки
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Завантажені зображення лежать у storage/app/public; сайт бачить їх через посилання `php artisan storage:link`
FILESYSTEM_DISK=local
# Листи, сповіщення й вебхуки обробляються через чергу в базі: потрібен запущений `php artisan queue:work`
# (його запускає `composer run dev`)
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------- Пошта ----------
# `log` — листи не надсилаються, а пишуться в storage/logs/laravel.log: зручно для розробки.
# `smtp` — справжня пошта або пісочниця (Mailpit): тоді заповніть хост, порт, логін і пароль нижче
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Від чийого імені йдуть листи гостям
MAIL_FROM_ADDRESS="hello@seatly.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------- Платежі ----------
# fake — підставна платіжна сторінка: оплата працює без токена й без інтернету (типово).
# monobank — Monobank Acquiring; потрібен токен нижче й публічна адреса для вебхуків
PAYMENT_GATEWAY=fake
# Тестовий токен видається на https://api.monobank.ua/ (кнопка «Отримати тестовий токен»). У репозиторій не потрапляє
MONOBANK_TOKEN=
# Адреса, на яку Monobank надсилає вебхуки. Заповнюється, коли сайт відкрито через тунель (cloudflared, ngrok),
# наприклад https://abc.trycloudflare.com/webhooks/monobank. Порожнє значення — адреса будується з APP_URL
MONOBANK_WEBHOOK_URL=

# ---------- Демо-дані ----------
# Пароль усіх демо-користувачів (owner@, manager@, waiter@, waiter2@, kitchen@ на домені нижче). На публічному демо обов'язково змініть
DEMO_PASSWORD=password
# Домен e-mail демо-користувачів; .test ніколи не належить реальним поштовим серверам
DEMO_EMAIL_DOMAIN=seatly.test
