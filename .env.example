# ---------- Застосунок ----------
APP_NAME="Seatly Restaurant"
APP_ENV=local
# Ключ шифрування; генерується командою `php artisan key:generate`
APP_KEY=
APP_DEBUG=true
# Адреса, за якою сайт відкривається у браузері
APP_URL=https://seatly.restaurant.ua

# Основна мова сайту й адмінки
APP_LOCALE=uk
# Мова написів інтерфейсу, якщо в основній бракує перекладу (у Filament перекладено не все).
# На вміст із бази (меню, тексти сторінок) не впливає: там порожній переклад завжди замінюється українським
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- База даних ----------
DB_CONNECTION=mysql
# В OSPanel 6 адреса сервера — це назва модуля MySQL, а не localhost
DB_HOST=MySQL-8.4
DB_PORT=3306
DB_DATABASE=seatly
DB_USERNAME=root
DB_PASSWORD=

# ---------- Сесії, кеш, черги ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Листи, сповіщення й вебхуки обробляються через чергу в базі (`php artisan queue:work`)
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------- Пошта ----------
# `log` — листи не надсилаються, а пишуться в storage/logs/laravel.log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@seatly.restaurant.ua"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------- Платежі ----------
# fake — підставна платіжна сторінка: оплата працює без токена й без інтернету (типово).
# monobank — Monobank Acquiring; потрібен токен нижче й публічна адреса для вебхуків
PAYMENT_GATEWAY=fake
# Тестовий токен видається на https://api.monobank.ua/ (кнопка «Отримати тестовий токен»). У репозиторій не потрапляє
MONOBANK_TOKEN=
# Адреса, на яку Monobank надсилає вебхуки. Заповнюється, коли сайт відкрито через тунель (cloudflared, ngrok),
# наприклад https://abc.trycloudflare.com/webhooks/monobank. Порожнє значення — адреса будується з APP_URL
MONOBANK_WEBHOOK_URL=

# ---------- Демо-дані ----------
# Пароль усіх демо-користувачів (owner@, manager@, waiter@, waiter2@, kitchen@ на домені нижче). На публічному демо обов'язково змініть
DEMO_PASSWORD=password
# Домен e-mail демо-користувачів; .test ніколи не належить реальним поштовим серверам
DEMO_EMAIL_DOMAIN=seatly.test
